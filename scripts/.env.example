# Meta Earth Transaction Forwarder Configuration
# Copy this file to .env and configure for your environment

# Meta Earth Chain Configuration
ME_CHAIN_ID=mechain_100-1
ME_RPC_ENDPOINT=http://localhost:36657
ME_FEE_DENOM=umec
ME_ADDRESS_PREFIX=me

# Signing Configuration
# IMPORTANT: Never commit your actual mnemonic to version control!
# Use Docker secrets in production (see docker-compose.yml)
# ME_SIGNER_MNEMONIC=your 24-word mnemonic phrase here

# Docker secret path (used when running in Docker with secrets)
ME_DOCKER_SECRET_PATH=/run/secrets/me_signer_mnemonic

# Transaction Configuration
ME_FORWARD_DEST=me139mq752delxv78jvtmwxhasyrycufsvr0mue6u
ME_TX_MEMO=Forwarded by Meta Earth Transaction Service
ME_GAS_PRICE=0.02
ME_GAS_LIMIT=200000

# Reliability & Error Handling
ME_MAX_RETRIES=3
ME_RETRY_DELAY=2000
ME_CONNECTION_TIMEOUT=30000
ME_BROADCAST_MODE=sync
ME_SIMULATE_TX=true

# Monitoring & Logging
ME_DEBUG_MODE=false
ME_LOG_TRANSACTIONS=true
ME_HEALTH_CHECK_INTERVAL=60000

# Server Configuration
PORT=3000

