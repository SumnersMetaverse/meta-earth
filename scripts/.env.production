# Meta Earth Transaction Forwarder - Production Configuration
# This file contains actual Meta Earth network configuration values

# ============================================================================
# Meta Earth Chain Configuration (Production Values)
# ============================================================================
ME_CHAIN_ID=mechain_100-1
ME_ADDRESS_PREFIX=me

# RPC Endpoint Configuration
# For local node (default from setup_local.sh):
ME_RPC_ENDPOINT=http://localhost:36657

# For production/remote node, use:
# ME_RPC_ENDPOINT=https://rpc.metaearth.network:26657

# API Endpoint (optional, for additional queries)
ME_API_ENDPOINT=http://localhost:1318

# ============================================================================
# Token & Fee Configuration
# ============================================================================
ME_FEE_DENOM=umec
ME_GAS_PRICE=0.02
ME_GAS_LIMIT=200000

# Minimum gas price from app config: 0.02umec
# Recommended gas limit for token transfers: 200000

# ============================================================================
# Signing Configuration (CRITICAL - KEEP SECURE)
# ============================================================================
# OPTION 1: Use Docker Secrets (Recommended for production)
ME_DOCKER_SECRET_PATH=/run/secrets/me_signer_mnemonic

# OPTION 2: Environment Variable (Development only)
# WARNING: Never commit actual mnemonics to version control!
# ME_SIGNER_MNEMONIC=your 24-word mnemonic phrase here

# Example test mnemonic from setup_local.sh (FOR LOCAL TESTING ONLY):
# ME_SIGNER_MNEMONIC=curtain hat remain song receive tower stereo hope frog cheap brown plate raccoon post reflect wool sail salmon game salon group glimpse adult shift

# ============================================================================
# Transaction Configuration
# ============================================================================
# Destination address for forwarded tokens
ME_FORWARD_DEST=me139mq752delxv78jvtmwxhasyrycufsvr0mue6u

# Alternative destination addresses from config:
# Global DAO: me139mq752delxv78jvtmwxhasyrycufsvr0mue6u
# MEID DAO: me1p7s6k4ecrm2kl0rs6399k99pyuk322dc78dcxq

# Transaction memo
ME_TX_MEMO=Forwarded by Meta Earth Transaction Service

# ============================================================================
# Reliability & Error Handling
# ============================================================================
# Maximum retry attempts for failed transactions
ME_MAX_RETRIES=3

# Delay between retries (milliseconds)
ME_RETRY_DELAY=2000

# Connection timeout (milliseconds)
ME_CONNECTION_TIMEOUT=30000

# Transaction broadcast mode: sync, async, or block
ME_BROADCAST_MODE=sync

# Enable transaction simulation before broadcast
ME_SIMULATE_TX=true

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Enable detailed logging
ME_DEBUG_MODE=false

# Log transaction details
ME_LOG_TRANSACTIONS=true

# Health check interval (milliseconds)
ME_HEALTH_CHECK_INTERVAL=60000

# ============================================================================
# Server Configuration
# ============================================================================
PORT=3000

# Enable CORS (for web frontend access)
ME_ENABLE_CORS=false

# Allowed origins (comma-separated)
ME_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Network Endpoints (Meta Earth Specific)
# ============================================================================
# These match the setup_local.sh configuration

# Settlement Layer (RPC): 36657 (default from setup)
# P2P: 36656
# gRPC: 8090
# gRPC-Web: 8091
# API: 1318
# JSON-RPC: 9545
# JSON-RPC WebSocket: 9546

# Token denomination: umec (micro MEC)
# 1 MEC = 1,000,000 umec = 10^6 umec
# 1 MEC = 10^18 base units (from config)
